# Required outside throwaway local development. Generate with: openssl rand -hex 32
LWC_SECRET=

# Separate enrollment secret shared only with the OpenHome Local Ability.
# Generate with: openssl rand -hex 32
DEVKIT_BOOTSTRAP_TOKEN=

# Stable HTTPS origin opened in a trusted browser and called by the DevKit. It must
# route to this service and must not contain a path.
PUBLIC_BASE_URL=https://voice.example.com

# Private persistent state. Back this up together with LWC_SECRET.
OPENHOME_GPT_DATA_DIR=./data

# Server-only key from https://app.openhome.com/dashboard/settings
OPENHOME_API_KEY=
OPENHOME_API_BASE=https://app.openhome.com

# Required when HOST is not loopback. Binds the OpenHome key to one ChatGPT identity.
APP_ALLOWED_CHATGPT_EMAIL=

# Initial offline wake name. It can also be changed later on the paired /setup page.
OPENHOME_GPT_LIVE_WAKE_PHRASE=juniper

# Codex may inspect, create, edit, and test files inside this directory.
CODEX_WORKSPACE=/absolute/path/to/a/workspace

# Optional: `disabled` means workspace-only. `confirmed` requires browser approval
# for host-computer tasks. `full` gives owner-authorized, approval-free access.
CODEX_MAC_CONTROL=disabled

# Optional: make GPT Live use the same character/personality as the OpenHome Agent.
# Keep it voice-first and concise. For multiline values, use your process manager's
# environment-file syntax.
GPT_LIVE_PERSONALITY_PROMPT=

# Optional comma-separated restriction. Leave empty to use account discovery.
LWC_ALLOWED_MODELS=
LWC_DEFAULT_MODEL=
# Optional model for first-party OpenAI web search. Defaults to LWC_DEFAULT_MODEL, then gpt-5.5.
LWC_SEARCH_MODEL=

# Optional AgentMail voice email. Configure both values with `bun run agentmail:setup`.
# The API key stays host-only; prefer an inbox-scoped key with inbox_read and message_send.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# Optional drafting model. Defaults to LWC_SEARCH_MODEL, LWC_DEFAULT_MODEL, then gpt-5.5.
LWC_AGENTMAIL_MODEL=

# Optional sister Ability integration. Configure both or neither. GPT Live sends only
# deterministic voice commands; Spotify OAuth and playback stay in openhome-spotify.
# Example URL when both services share one host: http://127.0.0.1:3199
OPENHOME_SPOTIFY_URL=
OPENHOME_SPOTIFY_TOOL_TOKEN=

HOST=127.0.0.1
PORT=3000
LWC_ALLOWED_ORIGINS=https://voice.example.com
NODE_ENV=production
