{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@opencoredev/loginwithchatgpt-core": ["vendor/login-with-chatgpt/packages/core/src/index.ts"],
      "@opencoredev/loginwithchatgpt-react": ["vendor/login-with-chatgpt/packages/react/src/index.ts"],
      "@opencoredev/loginwithchatgpt-server": ["vendor/login-with-chatgpt/packages/server/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "react", "react-dom"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
